{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axiom teststats artifacts v1",
  "description": "Axiom teststats attempt and run snapshots. Examples: ../docs/JSON-FORMAT.md. Lifecycle and partial results: ../docs/LIFECYCLE.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/attempt"
    },
    {
      "$ref": "#/$defs/run"
    }
  ],
  "$defs": {
    "attempt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "attempt"
        },
        "process_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "running",
            "finished",
            "finalized"
          ]
        },
        "case_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "test_name": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        },
        "skip_reason": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ns": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schema_version",
        "kind",
        "process_id",
        "run_id",
        "number",
        "revision",
        "state",
        "name",
        "test_name",
        "meta",
        "started_at",
        "duration_ns"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "running"
              }
            }
          },
          "then": {
            "properties": {
              "duration_ns": {
                "const": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "status"
                  ]
                },
                {
                  "required": [
                    "finished_at"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "status",
              "finished_at"
            ]
          }
        }
      ]
    },
    "run": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "run"
        },
        "process_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attempt_reference"
          }
        },
        "summary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/summary"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "kind",
        "process_id",
        "run_id",
        "attempts",
        "summary"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "epic": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "suite": {
          "type": "string"
        },
        "story": {
          "type": "string"
        },
        "layer": {
          "type": "string"
        },
        "feature": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "sub_suite": {
          "type": "string"
        },
        "parent_suite": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "test_cases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "attempt_reference": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "running",
            "finished",
            "finalized"
          ]
        }
      },
      "required": [
        "number",
        "revision",
        "state"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/meta"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "skipped",
            "flaky"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ns": {
          "type": "integer",
          "minimum": 0
        },
        "elapsed_ns": {
          "type": "integer"
        }
      },
      "required": [
        "name",
        "meta",
        "status",
        "started_at",
        "finished_at",
        "duration_ns",
        "elapsed_ns"
      ],
      "additionalProperties": false
    }
  }
}
